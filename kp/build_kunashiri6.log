== 区間 kishi（岸内線（岸内〜南利寄））ハッシュ 経路 8b81ca4ed2c7・線形 9a76dd701062・縦断 1b715f25bc58
  $ rm -f branch_kishi_cands.json
  $ VMAX='85' TILT='0' TRAIN='80' python3 ipfit_branch.py kishi route_kishi.json fit_minami.json start end=fit_kita_e.json > ipb_kishi.log 2>&1
  $ ROUTE='route_kishi.json' python3 fit2route.py kishi > geo_kishi.log 2>&1
  $ python3 ground.py route_fkishi.json ground_fkishi.json > ground_kishi.log 2>&1
  高さの指定表 _free： {'start_z': 64.3, 'end_z': 109.8} 0 駅を指定
  高さの指定表 _gs： {'start_z': 64.3, 'end_z': 109.8} 1 駅を指定
  $ GCAP='0.025' BRIDGE_H1='60' BRIDGE_H2='100' BRIDGE_SPAN='300' W_BH2='100' DEPTH_MAX='40' EXIT_R='200' python3 design3.py ground_fkishi.json costs_single.json design_fkishi.json height_spec_kishi.json > d_kishi.log 2>&1
== 区間 seoi（瀬生線（上遠根別〜瀬生〜岸内））ハッシュ 経路 374c34a90572・線形 4fa7b4f8b876・縦断 8416d0847086
  $ ROUTE='route_seoi.json' OUT='route_seoi_hyb.json' PREFIX='seoi_' GDEF='0.025' BRIDGE_H1='60' BRIDGE_H2='100' BRIDGE_SPAN='300' W_BH2='100' DEPTH_MAX='40' EXIT_R='200' LAMBDA='1.0' python3 devline_hybrid.py > hyb_seoi.log 2>&1
  $ rm -f branch_seoi_cands.json
  $ VMAX='85' TILT='0' TRAIN='80' python3 ipfit_branch.py seoi route_seoi_hyb.json fit_onne.json start end=fit_minami.json > ipb_seoi.log 2>&1
  $ ROUTE='route_seoi_hyb.json' python3 fit2route.py seoi > geo_seoi.log 2>&1
  $ python3 ground.py route_fseoi.json ground_fseoi.json > ground_seoi.log 2>&1
  高さの指定表 _free： {'start_z': 338.6, 'end_z': 64.3} 0 駅を指定
  高さの指定表 _gs： {'start_z': 338.6, 'end_z': 64.3} 4 駅を指定
  $ GCAP='0.025' BRIDGE_H1='60' BRIDGE_H2='100' BRIDGE_SPAN='300' W_BH2='100' DEPTH_MAX='40' EXIT_R='200' python3 design3.py ground_fseoi.json costs_single.json design_fseoi.json height_spec_seoi.json > d_seoi.log 2>&1
